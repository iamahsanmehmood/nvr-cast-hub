{
  "manifest_version": 3,
  "name": "NVR Cast Hub — Live Video Sync & Remote (v0.1.0-beta)",
  "version": "0.1.0",
  "description": "Cast live browser video players directly to NVR with real-time seek, pause, PiP & background tab continuity, Photo Gallery & PC Monitor controls.",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NVR Cast Hub (v0.1.0-beta)"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
